<?xml version="1.0"?>
<configuration>

  <connectionStrings>
    <add name="InterviewTestConnection"
         connectionString="Data Source=.;Initial Catalog=InterViewTest;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>

</configuration>
